{
    "statusLine": {
        "type": "command",
        "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/statusline.sh"
    },
    "hooks": {
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/start.sh"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"${CLAUDE_PROJECT_DIR}/.agents/scripts/hooks/log_user_prompt.py\""
                    }
                ]
            }
        ],
        "PermissionRequest": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/approve.sh"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop.sh"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"${CLAUDE_PROJECT_DIR}/.agents/scripts/hooks/guard_git.py\"",
                        "timeout": 600
                    }
                ]
            },
            {
                "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"${CLAUDE_PROJECT_DIR}/.agents/scripts/hooks/guard_task.py\""
                    }
                ]
            },
            {
                "matcher": "mcp__.*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"${CLAUDE_PROJECT_DIR}/.agents/scripts/hooks/guard_sql.py\""
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"${CLAUDE_PROJECT_DIR}/.agents/scripts/hooks/loop_guard.py\""
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"${CLAUDE_PROJECT_DIR}/.agents/scripts/hooks/probe_identity.py\""
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"${CLAUDE_PROJECT_DIR}/.agents/scripts/hooks/limit_guard.py\""
                    }
                ]
            }
        ]
    },
    "permissions": {
        "deny": [
            "Bash(git push)",
            "Bash(git push *)",
            "Bash(git reset --hard*)",
            "Bash(git clean -f*)",
            "Bash(gh pr create*)",
            "Bash(gh pr merge*)"
        ]
    }
}
